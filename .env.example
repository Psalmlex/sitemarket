PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/sitemarket
# Generate a real secret with: openssl rand -hex 32
# Required (non-default) when NODE_ENV=production — the server will refuse to start otherwise.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@sitemarket.local
# Change this before running seed.js anywhere but your own machine.
ADMIN_PASSWORD=Admin123!
NODE_ENV=development
